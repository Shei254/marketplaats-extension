node_modules/
dist/
*.log
.DS_Store
/.claude
.claude/
.agents/
/skills-lock.json
ralf/
# The seeded design-canvas payload: ~2.3 MB of editor code generated from the
# .dc.html sources beside it. Re-seed with docs/design/README.md rather than commit it.
docs/design/*.html
!docs/design/*.dc.html

# The extension's private signing key. The *public* half is committed, in
# apps/extension/public/manifest.json as `key` — that is what pins the id.
apps/extension/keys/

# Credentials and machine-specific settings, one file for the whole repository: `cp .env.example .env`.
# The example is committed and documents every variable; the file itself never is.
/.env
/.env.local
