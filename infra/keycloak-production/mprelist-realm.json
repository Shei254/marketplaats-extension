{
  "realm": "mprelist",
  "displayName": "mprelist (production)",
  "enabled": true,
  "sslRequired": "${MPRELIST_SSL_REQUIRED:external}",
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "loginTheme": "mprelist",
  "emailTheme": "mprelist",
  "internationalizationEnabled": true,
  "supportedLocales": ["nl"],
  "defaultLocale": "nl",
  "smtpServer": {
    "host": "${MPRELIST_SMTP_HOST:}",
    "port": "${MPRELIST_SMTP_PORT:587}",
    "from": "${MPRELIST_SMTP_FROM:no-reply@mprelist.invalid}",
    "fromDisplayName": "AdBump",
    "auth": "true",
    "user": "${MPRELIST_SMTP_USER:}",
    "password": "${MPRELIST_SMTP_PASSWORD:}",
    "starttls": "true",
    "ssl": "false"
  },
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 2592000,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Operator of the tier catalog. Guards the admin module (T18); ADR-0014 deferred the CRUD screens, so this role currently opens endpoints and no UI."
      }
    ]
  },
  "clients": [
    {
      "clientId": "mprelist-extension",
      "name": "Chrome extension",
      "description": "Public client, Authorization Code + PKCE through chrome.identity.launchWebAuthFlow (ADR-0010).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "https://${MPRELIST_EXTENSION_ID:unset-extension-id}.chromiumapp.org/"
      ],
      "webOrigins": [
        "chrome-extension://${MPRELIST_EXTENSION_ID:unset-extension-id}"
      ],
      "defaultClientScopes": [
        "basic",
        "acr",
        "roles",
        "web-origins"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "mprelist-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "mprelist-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "mprelist-dashboard",
      "name": "Dashboard SPA",
      "description": "Public client, Authorization Code + PKCE from the browser. Both site origins are registered: apps/web is one image serving one bundle, which picks its surface by path (ADR-0017), so www. and admin. are the same client arriving from two hostnames.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${MPRELIST_WEB_BASE_URL:https://web-base-url-unset.invalid}/",
        "${MPRELIST_ADMIN_BASE_URL:https://admin-base-url-unset.invalid}/"
      ],
      "webOrigins": [
        "${MPRELIST_WEB_BASE_URL:https://web-base-url-unset.invalid}",
        "${MPRELIST_ADMIN_BASE_URL:https://admin-base-url-unset.invalid}"
      ],
      "defaultClientScopes": [
        "basic",
        "acr",
        "roles",
        "web-origins"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "mprelist-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "mprelist-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "mprelist-api",
      "name": "Spring Boot resource server",
      "description": "Mints no token and starts no flow: it exists to be the audience the other two put in theirs, and the client id apps/api validates against (T10).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [],
      "webOrigins": []
    }
  ]
}
