#!/usr/bin/env bash
#
# A wizard — walks a human through a manual procedure step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library — delightful, consistent UX. Identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear — wipe the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" — opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later — it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" — clear the screen, then announce a stage and show progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." — a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." — a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL — open in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser — visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser — visit it manually: $url"
}

# pause "msg" — wait for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" — y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY — current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" — read a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" — like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE — upsert KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE — set a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name — gh not ready; set it later"
}

# set_var NAME VALUE — set a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name — gh not ready; set it later"
}

# finish — clear, then a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES — author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# ──────────────────────────────────────────────────────────────────────────

TOTAL_STAGES=9

# Captured values are the operator's own conveniences across re-runs — which host, which
# tag — and not the product's. They deliberately do NOT go in the repository's `.env`:
# that one is the *development* stack's, it is loaded into `./gradlew bootRun` and every
# test JVM, and nothing about a production host belongs in it.
ENV_FILE="${MPRELIST_WIZARD_ENV:-$HOME/.mprelist-deploy.env}"

banner "Deploying mprelist"

# ── 1 ─────────────────────────────────────────────────────────────────────
stage "Preflight — this machine"
say "This wizard runs on YOUR machine. It drives ssh and your browser; it never"
say "asks for a password and never touches production.env."
printf '\n'
for tool in git ssh scp docker gh; do
  if command -v "$tool" >/dev/null 2>&1; then
    printf '  %s✓%s %s\n' "$GREEN" "$RESET" "$tool"
  else
    warn "$tool is missing — install it before going further"
    SKIPPED+=("install $tool")
  fi
done
printf '\n'
if git rev-parse --git-dir >/dev/null 2>&1; then
  note "branch: $(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
  note "head:   $(git rev-parse --short HEAD 2>/dev/null || echo '?')"
else
  warn "not inside the repository — run this from your checkout"
fi
printf '\n'
# The three the deploy job needs. Checked for existence, never captured: the value of
# MPRELIST_DEPLOY_SSH_KEY is a private key, and a wizard that reads one onto a terminal
# and into a shell history is a worse idea than the typing it saves. They are set once,
# when the host is first built, and are why `git push origin v1.0.0` is the whole deploy.
if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
  say "Actions secrets the deploy job needs:"
  for s in MPRELIST_DEPLOY_SSH_KEY MPRELIST_DEPLOY_KNOWN_HOSTS MPRELIST_DEPLOY_TARGET; do
    if gh secret list --json name -q '.[].name' 2>/dev/null | grep -qx "$s"; then
      printf '  %s✓%s %s\n' "$GREEN" "$RESET" "$s"
    else
      warn "$s is not set — the deploy job cannot reach the host without it"
      SKIPPED+=("gh secret set $s")
    fi
  done
else
  note "gh not authenticated — skipping the Actions secret check"
fi
printf '\n'
ask SSH_TARGET "SSH target for the production host (user@host):"
ask DEPLOY_DIR "Deploy directory on that host [/opt/mprelist]:"
[[ -n "$DEPLOY_DIR" ]] || DEPLOY_DIR=/opt/mprelist
write_env SSH_TARGET "$SSH_TARGET"
write_env DEPLOY_DIR "$DEPLOY_DIR"

# ── 2 ─────────────────────────────────────────────────────────────────────
stage "Cutover — install the deploy scripts on the host"
say "The ONLY thing ever copied to that host by hand, and only until it is current."
printf '\n'
note "Before T81 the host was a git checkout and every release needed a git pull."
note "Now the compose file, Caddyfile, realm export, Postgres init and the login"
note "theme all travel as a GHCR package the host pulls with the token it already"
note "has. But the *old* mprelist-deploy knows nothing about that package, so it"
note "cannot fetch its own replacement. This stage breaks that circle, once."
printf '\n'
if confirm "Install infra/deploy/mprelist-deploy and mprelist-backup on $SSH_TARGET?"; then
  scp infra/deploy/mprelist-deploy infra/deploy/mprelist-backup "$SSH_TARGET:/tmp/"
  # shellcheck disable=SC2029
  ssh -t "$SSH_TARGET" "sudo install -m 755 /tmp/mprelist-deploy /tmp/mprelist-backup /usr/local/bin/ && rm -f /tmp/mprelist-deploy /tmp/mprelist-backup && ls -l /usr/local/bin/mprelist-*"
  printf '  %s✓%s scripts installed\n' "$GREEN" "$RESET"
else
  SKIPPED+=("install mprelist-deploy + mprelist-backup on $SSH_TARGET")
  warn "skipped — every stage after this one assumes the new scripts are in place"
fi
pause

# ── 3 ─────────────────────────────────────────────────────────────────────
stage "Preflight — the host"
say "Three things the deploy needs, none of which it can create for you."
printf '\n'
step "A read-only GHCR login, so the host can pull all three packages."
step "MPRELIST_IMAGE_REPOSITORY in production.env — the new script reads it to"
say  "  find the deploy package, and the compose file reads it for the other two."
step "MPRELIST_IMAGE_TAG — rewritten by every deploy; it just has to exist."
printf '\n'
# shellcheck disable=SC2029
ssh "$SSH_TARGET" "
  set -u
  echo '--- production.env ---'
  for key in MPRELIST_IMAGE_REPOSITORY MPRELIST_IMAGE_TAG MPRELIST_KEYCLOAK_URL MPRELIST_REALM_DIR; do
    line=\$(grep -E \"^\$key=\" '$DEPLOY_DIR/production.env' 2>/dev/null || true)
    if [ -n \"\$line\" ]; then echo \"  ok   \$line\"; else echo \"  MISSING  \$key\"; fi
  done
  echo '--- GHCR ---'
  if [ -f ~/.docker/config.json ] && grep -q 'ghcr.io' ~/.docker/config.json; then
    echo '  ok   a ghcr.io credential is present'
  else
    echo '  MISSING  docker login ghcr.io  (read:packages token, never the push token)'
  fi
  echo '--- layout ---'
  echo \"  \$( [ -d '$DEPLOY_DIR/.git' ] && echo 'note  $DEPLOY_DIR is still a git checkout; safe to delete .git once a deploy has run' || echo 'ok   not a git checkout' )\"
" || warn "could not reach $SSH_TARGET"
printf '\n'
pause "Everything above 'ok'? Press Enter."

# ── 4 ─────────────────────────────────────────────────────────────────────
stage "Choose what to deploy"
say "A version tag is the normal path: pushing it IS the deploy. Actions runs the"
say "three test jobs, renames the digests master already built, and SSHes in."
printf '\n'
note "It must be a commit master has already built — a release renames an existing"
note "digest rather than building a second one — and a commit from after T81, since"
note "anything older carries no deploy package at all."
printf '\n'
say "Latest tags:"
git tag --list 'v*' --sort=-v:refname | head -5 | sed 's/^/    /' || true
printf '\n'
ask RELEASE_TAG "Tag to release (e.g. v1.0.1), or an existing sha-<commit>:"
write_env RELEASE_TAG "$RELEASE_TAG"
printf '\n'
case "$RELEASE_TAG" in
  v*)
    say "Pushing this tag starts a real deploy against the only copy of every"
    say "subscription this product has."
    if confirm "git tag $RELEASE_TAG && git push origin $RELEASE_TAG ?"; then
      git tag "$RELEASE_TAG"
      git push origin "$RELEASE_TAG"
      printf '  %s✓%s pushed — Actions has it now\n' "$GREEN" "$RESET"
    else
      SKIPPED+=("push tag $RELEASE_TAG")
    fi
    ;;
  sha-*)
    note "An unreleased build. Two ways in:"
    note "  Actions → CI → Run workflow, with $RELEASE_TAG as the image tag; or"
    note "  ssh $SSH_TARGET 'mprelist-deploy $RELEASE_TAG'"
    ;;
esac
pause

# ── 5 ─────────────────────────────────────────────────────────────────────
stage "Watch the pipeline"
say "The deploy job waits on all three test jobs, then: fetch the tree, pg_dump,"
say "replace the tree, pull the images, write the tag, up --wait."
open_url "https://github.com/Shei254/marketplaats-extension/actions"
printf '\n'
note "If the theme moved in this release the deploy also force-recreates Keycloak,"
note "because compose does not notice a bind mount's contents changing and a"
note "deployed Keycloak caches themes."
printf '\n'
warn "There is no automatic rollback, deliberately. A failed migration is recovered"
note "  from the dump the deploy took seconds earlier, by a human reading the error."
printf '\n'
pause "Wait for the run to finish, then press Enter."

# ── 6 ─────────────────────────────────────────────────────────────────────
stage "Keycloak — the themes"
say "THE STAGE NOBODY CAN SKIP, and the one no deploy will ever do for you."
printf '\n'
note "A realm is imported on first start and never again while its database exists."
note "loginTheme and emailTheme are realm *properties*, so a realm that came up"
note "before T80 or T82 does not ask for our themes however perfectly the files"
note "arrive. These are set once, by hand, and then they are set for good."
printf '\n'
ask KEYCLOAK_URL "Keycloak base URL (e.g. https://auth.adbump.nl):"
write_env KEYCLOAK_URL "$KEYCLOAK_URL"
open_url "$KEYCLOAK_URL/admin/master/console/#/mprelist/realm-settings/themes"
printf '\n'
step "Sign in as an admin. If the deep link does not land, click through:"
say  "    Realm selector → mprelist → Realm settings → Themes"
step "Set Login theme to: mprelist"
step "Set Email theme to: mprelist"
say  "    The mail a forgotten password sends. Unset, it goes out as two unstyled"
say  "    paragraphs telling the customer about their 'mprelist (production)'"
say  "    account, from a sender with no name on it (T82)."
say  "    The deploy checks the login theme by fetching the page. There is no page"
say  "    to fetch for a mail, so this line is the only thing that will say so."
step "Save."
printf '\n'
pause "Done? Press Enter."

# ── 7 ─────────────────────────────────────────────────────────────────────
stage "Keycloak — language and label"
say "Two more realm properties from the same import, in the same position."
printf '\n'
open_url "$KEYCLOAK_URL/admin/master/console/#/mprelist/realm-settings/localization"
step "Realm settings → Localization → Internationalization: ON"
step "Supported locales: Dutch (nl).  Default locale: Dutch (nl).  Save."
say  "    Without this, signing in is the one step of the product in English."
printf '\n'
step "Realm settings → General → Display name: mprelist (production)"
say  "    An operator's label for the realm, on no page a customer sees — which is"
say  "    why it is the identifier and not the brand. It read 'Bumpr' for a month."
printf '\n'
pause "Both saved? Press Enter."

# ── 8 ─────────────────────────────────────────────────────────────────────
stage "Verify the sign-in page"
say "The deploy checks this too. Here you look at it."
printf '\n'
say "What the page reports:"
# shellcheck disable=SC2029
ssh "$SSH_TARGET" "curl -fsSL --max-time 20 '$KEYCLOAK_URL/realms/mprelist/account/' 2>/dev/null | grep -q 'login-shell' && echo '  ok   the sign-in page is ours' || echo '  NO   Keycloak is still serving its own page'" \
  || warn "could not reach the host"
printf '\n'
note "Still Keycloak's? Two causes, in this order:"
note "  1. Stage 6 was skipped or not saved — the realm is not asking for the theme."
note "  2. Keycloak is serving a cached theme. The deploy restarts it when the theme"
note "     changed; if you changed the realm setting just now, restart it yourself:"
note "       ssh $SSH_TARGET \"cd $DEPLOY_DIR && docker compose --env-file production.env \\"
note "         -f infra/docker-compose.prod.yml up -d --force-recreate --no-deps keycloak\""
printf '\n'
open_url "$KEYCLOAK_URL/realms/mprelist/account/"
pause "Look at it in the browser, then press Enter."

# ── 9 ─────────────────────────────────────────────────────────────────────
stage "Afterwards"
say "What to run when something looks wrong, and what covers you when it is."
printf '\n'
say "Health and logs:"
note "  ssh $SSH_TARGET \"cd $DEPLOY_DIR && docker compose --env-file production.env \\"
note "    -f infra/docker-compose.prod.yml ps\""
note "  ...same, with: logs -f api"
printf '\n'
say "Settings that need no deploy at all — the client-config patch, the pacing"
say "window, the Stripe keys are read at start:"
note "  edit production.env, then: up -d      (no tag, no pipeline, nothing rebuilt)"
printf '\n'
say "Backups, each covering what the one below cannot:"
note "  Hostinger weekly VPS snapshot   ≤ 7 days   the VPS ceasing to exist"
note "  nightly pg_dump cron, 7 kept    ≤ 24 h     a bad migration or a down -v"
note "  the deploy's own dump           seconds    the migration it is about to run"
printf '\n'
warn "infra/ and apps/ on that host are replaced wholesale on every deploy."
note "  Anything you edit there is gone at the next one. production.env is not"
note "  touched, and is the only file on that machine that is yours."
printf '\n'
pause

finish
