{
  "name": "@mprelist/extension",
  "version": "0.0.1",
  "private": true,
  "description": "Chrome MV3 extension to relist Marktplaats ads (POC). See docs/specs/poc-relist.md at the repo root.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "extension-id": "node scripts/extension-key.mjs id",
    "extension-key": "node scripts/extension-key.mjs"
  },
  "dependencies": {
    "@mprelist/contracts": "*"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^26.2.0",
    "esbuild": "^0.24.0",
    "happy-dom": "^20.11.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
