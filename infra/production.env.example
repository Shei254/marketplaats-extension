# The deployed stack's own environment — the file infra/docker-compose.prod.yml is run with (T55, #86).
#
#   cp infra/production.env.example production.env    # on the host, once
#   docker compose --env-file production.env -f infra/docker-compose.prod.yml up -d --build --wait
#
# This is not `.env`. That one is the *development* stack's, it commits well-known passwords on purpose, and
# it is loaded into `./gradlew bootRun` and the test JVMs; nothing in it belongs on a server. `production.env`
# is gitignored by name for the same reason `.env` is.
#
# **Every variable below that ships empty has no default and no fallback.** Compose refuses to start and
# names the one that is missing, which is the only moment anybody is looking. Two of them cost more than a
# restart to get wrong — see § Imported once.

# --- Secrets ------------------------------------------------------------------------------------------
#
# Generated on the host and written here, never committed and never reused between environments. Something
# like `openssl rand -base64 30` for each.

# The application's own database role, created by the Postgres image on first start.
MPRELIST_DB_PASSWORD=

# Keycloak's, in its own database beside it — created by ./postgres/init-production/10-keycloak-database.sh,
# which reads this same variable. Changing it later is an `ALTER ROLE` and this line, not this line alone.
MPRELIST_KEYCLOAK_DB_PASSWORD=

# The Keycloak bootstrap admin, created on **first start only**. This is the account that can do anything to
# the realm, so it is not `admin` / `admin` — that pair is the local stack's, committed because a laptop is
# not reachable. Sign in with it once, make yourself a proper admin user, and stop using it.
MPRELIST_KEYCLOAK_ADMIN=
MPRELIST_KEYCLOAK_ADMIN_PASSWORD=


# --- Where the three public things are ------------------------------------------------------------------
#
# All three are the addresses a *browser* uses, which is the same thing the API validates tokens against and
# the same thing the realm registers. TLS terminates in front of this stack (T56, #87), so every one of them
# is `https://` on a deployed host.

# Keycloak's own base address. Four settings are derived from this one variable rather than written down
# four times: Keycloak's `KC_HOSTNAME`, the issuer this API trusts, the issuer the admin corner signs into,
# and — through the first — the issuer stamped into every token. The realm name is not a variable: it is
# `mprelist`, which is what the realm export declares.
MPRELIST_KEYCLOAK_URL=https://auth.example.com

# Where `apps/web` is served — the public pages a Stripe Checkout sends a browser back to, and the origin the
# API allows the admin corner to call it from.
MPRELIST_WEB_BASE_URL=https://www.example.com

# Where this API is served, which is what the site's admin corner calls. The extension has its own copy of
# this compiled in (`apps/extension/src/api/api-config.ts`) and T56/T58 is what points a published build at it.
MPRELIST_API_BASE_URL=https://api.example.com


# --- Imported once --------------------------------------------------------------------------------------
#
# Keycloak imports a realm on first start and never again while its database exists, so both of these are
# read exactly once and getting one wrong is a `down -v` on production rather than a restart. Neither has a
# default. T56 (#87) owns both.

# The directory holding the production realm export, relative to `infra/`. **Not `./keycloak`** — that realm
# is the local stack's, with two dev users sharing one password and every redirect URI on localhost.
MPRELIST_REALM_DIR=./keycloak-production

# The published extension id, which the realm registers `https://<id>.chromiumapp.org/` for. The Web Store
# signs uploads with its own key and so assigns a different id than the one this repository's key derives:
# `npm run extension-key -w @mprelist/extension -- set <the Web Store public key>` prints the one to use.
MPRELIST_EXTENSION_ID=


# --- Stripe -----------------------------------------------------------------------------------------------
#
# **Both may be left empty here, and that is deliberate**: T57 (#88) is what puts live keys in, and this stack
# has to be deployable before it. Unset, the API starts, says so at WARN, refuses every webhook it is sent and
# shows no amounts — fail-closed, never a guess. Nobody can subscribe until they are set.
MPRELIST_STRIPE_SECRET_KEY=
MPRELIST_STRIPE_WEBHOOK_SECRET=


# --- The client-config patch --------------------------------------------------------------------------------
#
# What the extension should do differently from what it was built to do (#36) — empty on a healthy day, which
# is what makes restarting the API the whole of the fix the day Marktplaats moves a path. One JSON document:
#
#   MPRELIST_CLIENT_CONFIG={"endpoints":{"deleteAd":"/seller/api/delete-ad-v2"}}
#
# A document this build cannot read stops the API from starting, on purpose: whoever sets it is deploying a
# fix for a breakage that is live, and this is the only moment they can be told it did not go out.
MPRELIST_CLIENT_CONFIG=


# --- How long a repost waits for the one before it ------------------------------------------------------

# The gap the extension leaves between two of its own relists, as a randomised window in milliseconds, and
# the rail this API refuses under. **The numbers most likely to be tuned after go-live**, which is why they
# are variables rather than a line of the JSON document above and a rebuild of the other side.
#
# Empty is the ordinary state and means what the images ship with: a 10s–30s window in the extension, and a
# 5s rail here. The window reaches an installed extension through `GET /api/client-config` on its next wake,
# so changing it is this file and a restart rather than a Web Store review that takes days.
#
# Set both ends of the window or neither, and keep its floor above the rail — a floor under the rail is every
# second repost meeting the cooldown the window exists to keep a user away from.
#
#   MPRELIST_PACING_MIN_MS=10000
#   MPRELIST_PACING_MAX_MS=30000
MPRELIST_PACING_MIN_MS=
MPRELIST_PACING_MAX_MS=

# The rail, as a duration (`5s`, `90s`, `2m`); `0s` turns it off. Commented out rather than empty: an empty
# duration is one this API refuses to start on, and the compose file's own `5s` is what applies while nobody
# has set this.
# MPRELIST_MINIMUM_INTERVAL=5s


# --- Mail -------------------------------------------------------------------------------------------------
#
# The realm sends a password reset, and a deployed realm with no mail server dead-ends every user who forgets
# their password. Commented out rather than empty: an empty assignment reaches Keycloak as a variable that is
# *defined and empty*, which defeats the realm file's own `${MPRELIST_SMTP_HOST:…}` default rather than
# falling back to it. Real credentials, not Mailtrap's sandbox.
# MPRELIST_SMTP_HOST=
# MPRELIST_SMTP_PORT=
# MPRELIST_SMTP_FROM=
# MPRELIST_SMTP_USER=
# MPRELIST_SMTP_PASSWORD=


# --- Where each container listens on the host ---------------------------------------------------------------
#
# Defaults are 80 for the site, 8080 for the API and 8081 for Keycloak — the same two numbers the local stack
# uses, so that what a developer knows carries over. Each takes a whole compose port spec, which is how a
# proxy in front of them (T56, #87) binds them to loopback and takes the public side itself:
#
#   MPRELIST_WEB_PORT=127.0.0.1:8000
#
# Until something is in front terminating TLS, publishing these on a public interface serves the site over
# plain HTTP — and Keycloak, whose realm is `sslRequired: external`, answers `403 HTTPS required` to every
# request that is not loopback. That is the setting working.
# MPRELIST_WEB_PORT=
# MPRELIST_API_PORT=
# MPRELIST_KEYCLOAK_PORT=
