{
  "key": "",
  "manifest_version": 3,
  "name": "{{brand.name}}",
  "version": "0.0.1",
  "description": "{{brand.tagline}}",
  "permissions": ["storage", "unlimitedStorage", "identity", "alarms"],
  "host_permissions": ["https://www.marktplaats.nl/*", "https://*.marktplaats.nl/*", "*://*.marktplaats.nl/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.marktplaats.nl/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "{{brand.name}}",
    "default_popup": "popup.html"
  }
}
